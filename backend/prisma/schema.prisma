// HubWorld data model.
//
// The XRP Ledger owns the truth about ticket ownership — a holder can transfer
// an NFToken in Xaman without ever touching Hubworld. Postgres is therefore an
// *index* over the ledger plus the off-ledger data XRPL cannot hold (usernames,
// event copy, bid history). Anything ownership-related carries a `syncedAt` so
// stale reads are detectable rather than silently wrong.
//
// Money is always BigInt drops (1 XRP = 1_000_000 drops). Never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Which XRP Ledger a row's on-ledger identifiers belong to.
 *
 * An `NFTokenID`, an offer index, a tx hash and an r-address are only meaningful
 * against one network. Without this column a database holding both is
 * indistinguishable to anything that reads the ledger: `ledger:sync` pointed at
 * mainnet saw every testnet ticket as "held by nobody we know", and `--apply`
 * would have rewritten ownership on rows that were perfectly correct.
 *
 * Deliberately NOT defaulted. A default means a forgotten field silently
 * mislabels a mainnet row as testnet, which is precisely the class of silent
 * wrongness this exists to prevent — so every create must state the network and
 * the compiler finds any that does not. Existing rows were backfilled to
 * TESTNET by the migration, which is what they factually are.
 *
 * Identity is deliberately absent from this: `User`, `Session` and
 * `SignInRequest` carry no network. A signature proving an @handle owns an
 * r-address is a `SignIn` pseudo-transaction that is never submitted to any
 * ledger, so the binding holds on all of them. The same person is the same
 * person on testnet and mainnet.
 */
enum XrplNetwork {
  TESTNET
  DEVNET
  MAINNET
}

// ---------------------------------------------------------------- identity --

model User {
  id          String   @id @default(uuid())
  username    String   @unique // @handle, stored lowercase
  xrplAddress String   @unique // r-address. Never a seed — Xaman holds the keys.
  displayName String?

  /// What this account may do. Organizers issue tickets and run doors, which is
  /// a materially different trust level from attending, so it is an account
  /// property rather than something inferred from owning an Event row.
  role UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizedEvents Event[]         @relation("EventOrganizer")
  ticketsOwned    Ticket[]        @relation("TicketOwner")
  listingsSelling Listing[]       @relation("ListingSeller")
  listingsBuying  Listing[]       @relation("ListingBuyer")
  bids            Bid[]
  sessions        Session[]
  signInRequests  SignInRequest[]
  mintRequests    MintRequest[]
  giftsSent       Gift[]          @relation("GiftSender")
  giftsReceived   Gift[]          @relation("GiftRecipient")
  redemptions     Redemption[]    @relation("RedeemedHolder")
  checkInsRun     Redemption[]    @relation("RedeemedByStaff")
  organizerApplication OrganizerApplication? @relation("Applicant")
  applicationsReviewed OrganizerApplication[] @relation("Reviewer")
  staffFor             EventStaff[]           @relation("StaffMember")
  staffGranted         EventStaff[]           @relation("StaffGrantedBy")

  @@index([xrplAddress])
}

/**
 * One Xaman SignIn payload. The user scans it in the Xaman app and signs;
 * signing proves they control the address, which is the only trustworthy way
 * to bind an @handle to an r-address.
 */
model SignInRequest {
  id          String       @id @default(uuid())
  payloadUuid String       @unique // Xaman payload UUID
  status      SignInStatus @default(PENDING)

  // Populated once Xaman reports the payload signed.
  resolvedAddress String?
  resolvedAt      DateTime?

  // Null when the address has never signed in before — the client must then
  // claim a username before a session is issued.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime

  // Set the moment a session is issued from this request. A signed payload is
  // single-use: without this, re-polling it would mint unlimited sessions from
  // one signature.
  consumedAt DateTime?

  @@index([status, expiresAt])
}

enum UserRole {
  USER // attends events: buys, holds, gifts, sells, bids
  ORGANIZER // additionally creates events, mints tickets, runs the door
  ADMIN // additionally reviews organizer applications
}

/**
 * Someone an organizer has authorised to work the door of one event.
 *
 * Checking people in and issuing tickets are very different powers. A door needs
 * casual staff and volunteers, and handing each of them ORGANIZER would let them
 * mint tickets, create events, and open auctions — the entire supply side of the
 * business, so that a friend can scan QRs for one evening.
 *
 * Scoped to a single event on purpose: staff for tonight's show should not be
 * able to work next month's, and access should lapse without anyone remembering
 * to revoke it.
 */
model EventStaff {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  userId String
  user   User   @relation("StaffMember", fields: [userId], references: [id])

  /// Who granted this, for answering "who let them in" after the fact.
  addedById String
  addedBy   User   @relation("StaffGrantedBy", fields: [addedById], references: [id])

  createdAt DateTime  @default(now())
  /// Set when access is withdrawn. Kept rather than deleted so the audit trail
  /// survives — a door dispute is exactly when you need to know who had access.
  revokedAt DateTime?

  @@unique([eventId, userId])
  @@index([eventId, revokedAt])
}

/**
 * A request to become an organizer.
 *
 * Organizers issue real admission and take real money, so becoming one is
 * reviewed rather than self-declared. One application per user: re-applying
 * updates the existing row so a rejected applicant cannot spam the queue.
 */
model OrganizerApplication {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation("Applicant", fields: [userId], references: [id])

  orgName String
  contact String
  /// What they intend to run. The reviewer's main signal.
  pitch   String

  status ApplicationStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  /// Why it was rejected, shown to the applicant.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SignInStatus {
  PENDING
  SIGNED
  REJECTED
  EXPIRED
}

/**
 * Bearer session. Only the SHA-256 hash of the token is stored, so a database
 * leak does not hand over live sessions.
 */
model Session {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// ------------------------------------------------------------------ events --

model Event {
  id          String   @id @default(uuid())
  /// Slug stays globally unique — it is a URL, and two events cannot share one
  /// path just because they issue on different ledgers.
  slug        String   @unique

  /// Which ledger this event's tickets are issued on. Every Ticket, MintRequest
  /// and Listing beneath it inherits the same value.
  network XrplNetwork
  title       String
  description String?
  venue       String?
  startsAt    DateTime

  /// Public URL of the event's poster in object storage. Null renders a
  /// generated fallback rather than a broken image — an organizer who has not
  /// uploaded one yet is the normal case, not an error.
  imageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])

  // On-ledger issuance. Taxon groups every ticket for this event.
  nftTaxon Int

  // Basis points (100 bps = 1%). Under brokered mode the organizer is the
  // issuer and collects royaltyBps as TransferFee; Hubworld brokers the
  // NFTokenAcceptOffer and takes platformBps from the spread.
  royaltyBps  Int @default(0)
  platformBps Int @default(0)

  ticketCount Int         @default(0)
  status      EventStatus @default(DRAFT)

  tickets      Ticket[]
  mintRequests MintRequest[]
  redemptions  Redemption[]
  staff        EventStaff[]

  @@index([status, startsAt])
  @@index([network, status])
}

/**
 * One in-flight NFTokenMint awaiting the organizer's signature in Xaman.
 *
 * Minting is asynchronous and Hubworld never signs: we build the transaction,
 * hand it to Xaman, and only learn the NFTokenID after the organizer signs and
 * the ledger validates. This row is what survives that gap — without it a
 * signed mint whose poll never came back would be an NFT on-ledger that
 * Hubworld has no record of.
 */
model MintRequest {
  id          String     @id @default(uuid())
  payloadUuid String     @unique // Xaman payload UUID
  status      MintStatus @default(PENDING)

  network XrplNetwork

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // The organizer, who is also the NFT issuer under brokered mode.
  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  // Off-ledger ticket metadata, applied to the Ticket once the mint lands.
  seat String?
  tier String?

  // Populated only after the ledger validates the transaction.
  txHash     String?
  nfTokenId  String?
  ticketId   String? @unique
  resolvedAt DateTime?

  // Why a mint failed, for the organizer to act on.
  failureReason String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([status, expiresAt])
  @@index([eventId, createdAt])
}

enum MintStatus {
  PENDING
  SIGNED // signed in Xaman, ledger result not yet confirmed
  MINTED // validated on-ledger, Ticket row written
  REJECTED
  EXPIRED
  FAILED // signed but the ledger rejected it
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  COMPLETED
  CANCELLED
}

// ----------------------------------------------------------------- tickets --

model Ticket {
  id        String @id @default(uuid())
  /// 64-char hex NFTokenID — the ticket's real identity, but only WITHIN a
  /// network. An NFTokenID is derived from the issuer's AccountID, the taxon
  /// and the issuer's sequence, none of which are network-specific: the same
  /// account minting the same taxon at the same sequence on two networks
  /// produces byte-identical ids. Reusing a seed across networks is ordinary in
  /// development, so this is reachable rather than theoretical. A global unique
  /// would reject a legitimate mainnet ticket, or let an upsert quietly rewrite
  /// the testnet row that already held the id.
  nfTokenId String

  network XrplNetwork

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Last KNOWN owner. Reconciled from the ledger; may lag reality, and may be
  // an address belonging to nobody with a Hubworld account.
  ownerId      String?
  owner        User?     @relation("TicketOwner", fields: [ownerId], references: [id])
  ownerAddress String?
  syncedAt     DateTime?

  seat   String?
  tier   String?
  status TicketStatus @default(MINTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings    Listing[]
  auctions    Auction[]
  transfers   Transfer[]
  gifts       Gift[]
  redemptions Redemption[]

  @@unique([network, nfTokenId])
  @@index([eventId, status])
  @@index([ownerId])
  @@index([network, status])
}

/**
 * A peer-to-peer gift in flight.
 *
 * XRPL has no "transfer" transaction, so a gift is TWO signatures on two
 * different devices: the sender creates a zero-amount sell offer restricted to
 * the recipient, then the recipient accepts it. Ownership does not move until
 * that second signature validates.
 *
 * Both halves are tracked here because the sender and the recipient poll
 * independently, and either can abandon partway.
 */
model Gift {
  id String @id @default(uuid())

  network XrplNetwork

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  fromId String
  from   User   @relation("GiftSender", fields: [fromId], references: [id])

  toId String
  to   User   @relation("GiftRecipient", fields: [toId], references: [id])

  // Snapshotted at creation: the addresses the offer was actually built for.
  // Re-resolving @handles later could silently retarget a gift in flight.
  fromAddress String
  toAddress   String

  status GiftStatus @default(PENDING_OFFER)

  // Phase 1 — sender creates the offer.
  offerPayloadUuid String  @unique
  offerTxHash      String?
  offerIndex       String? // NFTokenOffer ledger index, assigned by the ledger

  // Phase 2 — recipient accepts it.
  acceptPayloadUuid String? @unique
  acceptTxHash      String?

  // Withdrawal — the sender changing their mind. Once the offer exists
  // on-ledger it can only be removed by a signed NFTokenCancelOffer, so this
  // needs its own payload rather than a local status flip.
  cancelPayloadUuid String? @unique
  cancelTxHash      String?

  failureReason String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  offeredAt  DateTime?
  resolvedAt DateTime?

  @@index([toId, status])
  @@index([fromId, status])
  @@index([ticketId, createdAt])
}

enum GiftStatus {
  PENDING_OFFER // waiting for the sender to sign
  OFFERED // offer is live on-ledger, waiting for the recipient
  ACCEPTING // recipient signed, ledger result not yet confirmed
  ACCEPTED // ownership moved
  DECLINED // recipient refused
  CANCELLING // sender signed a withdrawal, ledger result not yet confirmed
  CANCELLED // sender withdrew, or never signed
  EXPIRED
  FAILED // a signed transaction the ledger rejected
}

enum TicketStatus {
  MINTED
  LISTED
  IN_AUCTION
  REDEEMED
  BURNED
}

/**
 * One check-in at the door.
 *
 * A ticket is proved by a SIGNATURE, not by showing something. A displayed QR can
 * be screenshotted and passed to a friend; a Xaman signature cannot, because it
 * requires the holder's device and key at that moment.
 *
 * Check-in is therefore organizer-initiated: the door device creates the payload
 * and the RESULT APPEARS THERE. If the attendee's phone showed the verdict, a
 * screenshot of a green tick would be enough to get in.
 *
 * Signing alone is not sufficient either — it proves who they are, not what they
 * hold. The ledger is re-read to confirm that address still holds a ticket for
 * this event, because they may have sold or gifted it since.
 */
model Redemption {
  id          String           @id @default(uuid())
  payloadUuid String           @unique
  status      RedemptionStatus @default(PENDING)

  network XrplNetwork

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Populated once a signature resolves to a holder with a valid ticket.
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  resolvedAddress String?
  holderId        String?
  holder          User?   @relation("RedeemedHolder", fields: [holderId], references: [id])

  /// Which staff account ran this check-in — an audit trail for door disputes.
  staffId String
  staff   User   @relation("RedeemedByStaff", fields: [staffId], references: [id])

  failureReason String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?

  @@index([eventId, status])
  @@index([ticketId])
}

enum RedemptionStatus {
  PENDING // waiting for the holder to sign at the door
  REDEEMED // admitted
  REJECTED // holder declined in Xaman
  EXPIRED
  NO_TICKET // signed, but holds no valid ticket for this event
  ALREADY_USED // the ticket had already been redeemed
}

// ------------------------------------------------------- fixed-price sales --

/**
 * A fixed-price resale, settled in XRPL brokered mode.
 *
 * THREE signatures, on three different accounts:
 *   1. seller   NFTokenCreateOffer  Amount=price, Destination=broker, tfSell
 *   2. buyer    NFTokenCreateOffer  Amount=price+fee, Owner=seller  (a bid)
 *   3. Hubworld NFTokenAcceptOffer  both offers + NFTokenBrokerFee=fee
 *
 * The seller's `Destination` is the broker so nobody can accept the sell offer
 * directly and bypass the platform fee. The organizer's royalty is not modelled
 * here at all — the NFToken's native TransferFee deducts it and pays the issuer
 * automatically, which is the whole reason minting sets it.
 */
model Listing {
  id String @id @default(uuid())

  network XrplNetwork

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  sellerId String
  seller   User   @relation("ListingSeller", fields: [sellerId], references: [id])
  // Snapshotted: re-resolving later could retarget a listing already on-ledger.
  sellerAddress String

  /// Which broker this listing's offers name as their `Destination`.
  ///
  /// Snapshotted for the same reason as `sellerAddress`, but the consequence is
  /// worse. Both offers are built with `Destination` = the broker, so only THAT
  /// account can ever settle them. Resolving the broker globally at settlement
  /// time means rotating `PLATFORM_SEED` silently strands every live offer on
  /// the ledger — unsettleable, with nothing recording which key they needed.
  ///
  /// Recording it here is also what makes more than one broker possible: with a
  /// single serialised account, every sale platform-wide queues behind one
  /// sequence, and one stuck transaction halts all of them.
  ///
  /// Nullable only for rows written before this existed; those name whichever
  /// broker was configured then. Run `npm run broker:backfill` before any key
  /// rotation, and treat null as "the current platform address" until then.
  brokerAddress String?

  /// What the seller receives before the issuer's TransferFee. Always drops.
  priceDrops BigInt
  /// Hubworld's cut, fixed at listing time from the event's platformBps, so a
  /// later config change cannot alter the terms a buyer already saw.
  platformFeeDrops BigInt @default(0)

  // Phase 1 — the seller's sell offer.
  listPayloadUuid String  @unique
  listTxHash      String?
  offerIndex      String? // NFTokenOffer index, assigned by the ledger

  // Phase 2 — the buyer's bid.
  buyerId        String?
  buyer          User?   @relation("ListingBuyer", fields: [buyerId], references: [id])
  buyerAddress   String?
  buyPayloadUuid String? @unique
  buyTxHash      String?
  buyOfferIndex  String?

  // Phase 3 — Hubworld's brokered match.
  brokerTxHash String?

  // Withdrawal, which needs a signed NFTokenCancelOffer once the offer exists.
  cancelPayloadUuid String? @unique
  cancelTxHash      String?

  /// Set when this sell offer exists to back an AUCTION rather than a
  /// fixed-price sale. Such a listing must NEVER appear in the marketplace or be
  /// directly buyable — its price is the auction floor, so buying it outright
  /// would take the ticket for the reserve and bypass the bidding entirely.
  auctionId String?  @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])

  status        ListingStatus @default(PENDING_OFFER)
  failureReason String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  listedAt  DateTime?
  closedAt  DateTime?

  @@index([status, createdAt])
  @@index([ticketId, createdAt])
  @@index([sellerId, status])
}

enum ListingStatus {
  PENDING_OFFER // waiting for the seller to sign
  ACTIVE // sell offer live on-ledger, purchasable
  BUYER_PENDING // a buyer committed, waiting for their signature
  SETTLING // both offers exist; Hubworld is brokering
  SOLD
  CANCELLING // seller signed a withdrawal, not yet confirmed
  CANCELLED
  EXPIRED
  FAILED
}

// ---------------------------------------------------------------- auctions --

model Auction {
  id String @id @default(uuid())

  network XrplNetwork

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  startsAt     DateTime
  endsAt       DateTime
  reserveDrops BigInt?

  status    AuctionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())

  bids Bid[]
  /// The holder's sell offer, which settlement brokers the winning bid against.
  listing Listing?

  @@index([status, endsAt])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  SETTLING
  SETTLED
  CANCELLED
}

/**
 * One bid: an XRPL buy offer, not an escrow.
 *
 * The original design escrowed each bid, but an XRPL `Escrow` releases on a time
 * or crypto-condition trigger and knows nothing about the NFT, so it cannot
 * settle a ticket sale atomically — it can pay a seller whose ticket never moves.
 * `NFTokenAcceptOffer` moves the NFT and the XRP together, all-or-nothing, so a
 * bid is an `NFTokenCreateOffer` with `Destination` = the broker.
 *
 * The trade-off, stated plainly: **funds are not locked.** A bidder can spend the
 * money after bidding, and settlement then fails with `tecINSUFFICIENT_FUNDS`.
 * Balance is therefore checked when the bid is placed and again at settlement,
 * falling back to the next-highest bid.
 *
 * The compensating benefit is that losing costs nothing: there is no refund to
 * process and no cancellation transaction a loser must sign. A losing offer is
 * inert on-ledger because only the broker can accept it.
 */
model Bid {
  id String @id @default(uuid())

  network XrplNetwork

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])

  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id])
  // Snapshotted: re-resolving the handle later could retarget a live offer.
  bidderAddress String?

  /// What the bidder pays if they win. The platform fee and the issuer's
  /// royalty come out of this, so the seller nets less. Always drops.
  amountDrops BigInt

  // The Xaman payload the bidder signs, and the resulting on-ledger buy offer.
  // buyOfferIndex is assigned by the ledger and is what settlement matches.
  bidPayloadUuid String? @unique
  buyTxHash      String?
  buyOfferIndex  String?

  status        BidStatus @default(PENDING)
  failureReason String?

  placedAt   DateTime  @default(now())
  expiresAt  DateTime?
  committedAt DateTime?

  // Drives the real-time price tracker: bids for one auction, in time order.
  @@index([auctionId, placedAt])
  @@index([auctionId, status])
}

enum BidStatus {
  PENDING // payload created, not yet signed — must NOT count as price
  COMMITTED // buy offer live on-ledger; this is a real bid
  OUTBID // superseded by a higher committed bid
  WON
  LOST // auction ended without winning; nothing to refund
  CANCELLED // withdrawn by the bidder
  FAILED // signed but the ledger rejected it
}

// -------------------------------------------------- provenance / transfers --

// Append-only history. For ticketing this is anti-fraud infrastructure:
// "who held this, when, and by which transaction" must be answerable.
model Transfer {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  network XrplNetwork

  fromAddress String?
  toAddress   String
  /// Unique per network, not globally: a transaction hash is a hash of the
  /// signed blob, and the same account submitting the same fields at the same
  /// sequence on two networks collides. Scoped for the same reason as
  /// `Ticket.nfTokenId`.
  txHash      String
  kind        TransferKind
  occurredAt  DateTime

  @@unique([network, txHash])
  @@index([ticketId, occurredAt])
}

enum TransferKind {
  MINT
  GIFT
  SALE
  AUCTION_SETTLE
  BURN
}

/// Overflow storage for the Socket.IO Postgres adapter.
///
/// The adapter broadcasts over LISTEN/NOTIFY, whose payload is capped at 8000
/// bytes; anything larger is written here and fetched by the receiving process.
///
/// In practice this table should stay EMPTY. An auction event is an id, an
/// amount, a handle and sometimes a tx hash — a couple of hundred bytes. It is
/// modelled anyway so the schema stays the source of truth for every table in
/// the database, and so a future event that does grow past the limit finds the
/// table waiting rather than failing at broadcast time.
///
/// Shape is dictated by the adapter, not by us: it queries these exact columns.
model SocketIoAttachment {
  id        BigInt   @id @default(autoincrement())
  // timestamptz, not Prisma's default timestamp: the adapter prunes old rows by
  // comparing this against now(), and a timezone-less column makes that
  // comparison depend on the server's zone.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payload   Bytes?

  @@map("socket_io_attachments")
}

// ------------------------------------------------------------- job locking --

/**
 * A lease held by whichever process is running a periodic job.
 *
 * The auction sweep must not run twice concurrently: two processes would each
 * pick the same due auction and try to broker it, and the second would waste a
 * transaction fee discovering the offers were already consumed.
 *
 * This is a lease rather than a Postgres advisory lock on purpose. Advisory
 * locks are scoped to a CONNECTION, and Prisma pools connections — the unlock
 * could easily land on a different connection than the lock, leaking it
 * permanently. A row with an expiry is connection-agnostic and self-healing: a
 * process that dies holding the lease simply lets it expire.
 */
model JobLock {
  name        String   @id
  lockedUntil DateTime
  owner       String
  updatedAt   DateTime @updatedAt
}

/**
 * Last known state of a Xaman payload.
 *
 * Exists so payload resolution can be PUSHED rather than polled. Every signature
 * flow — sign-in, mint, gift, listing, bid, check-in — used to ask Xaman on every
 * poll, which is one request per 2.5s per waiting user and is what produced a 429
 * during the first live gift.
 *
 * With a webhook configured, Xaman tells us once and this row is the answer from
 * then on. Without one, this is a cache in front of the same polling as before.
 *
 * `terminal` matters: signed, cancelled and expired are final, so a terminal row
 * can be served forever without asking again.
 */
model XamanPayload {
  uuid String @id

  signed    Boolean @default(false)
  cancelled Boolean @default(false)
  expired   Boolean @default(false)
  /// The r-address that signed. Only ever written from an authenticated fetch,
  /// never from a webhook body.
  account   String?
  txid      String?

  terminal Boolean @default(false)
  /// Where the current values came from, for debugging a stuck payload.
  source   String  @default("poll")

  createdAt DateTime @default(now())
  fetchedAt DateTime @default(now())

  @@index([terminal, fetchedAt])
}
