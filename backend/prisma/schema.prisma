// HubWorld data model.
//
// The XRP Ledger owns the truth about ticket ownership — a holder can transfer
// an NFToken in Xaman without ever touching Hubworld. Postgres is therefore an
// *index* over the ledger plus the off-ledger data XRPL cannot hold (usernames,
// event copy, bid history). Anything ownership-related carries a `syncedAt` so
// stale reads are detectable rather than silently wrong.
//
// Money is always BigInt drops (1 XRP = 1_000_000 drops). Never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity --

model User {
  id          String   @id @default(uuid())
  username    String   @unique // @handle, stored lowercase
  xrplAddress String   @unique // r-address. Never a seed — Xaman holds the keys.
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizedEvents Event[]         @relation("EventOrganizer")
  ticketsOwned    Ticket[]        @relation("TicketOwner")
  listingsSelling Listing[]       @relation("ListingSeller")
  listingsBuying  Listing[]       @relation("ListingBuyer")
  bids            Bid[]
  sessions        Session[]
  signInRequests  SignInRequest[]
  mintRequests    MintRequest[]
  giftsSent       Gift[]          @relation("GiftSender")
  giftsReceived   Gift[]          @relation("GiftRecipient")

  @@index([xrplAddress])
}

/**
 * One Xaman SignIn payload. The user scans it in the Xaman app and signs;
 * signing proves they control the address, which is the only trustworthy way
 * to bind an @handle to an r-address.
 */
model SignInRequest {
  id          String       @id @default(uuid())
  payloadUuid String       @unique // Xaman payload UUID
  status      SignInStatus @default(PENDING)

  // Populated once Xaman reports the payload signed.
  resolvedAddress String?
  resolvedAt      DateTime?

  // Null when the address has never signed in before — the client must then
  // claim a username before a session is issued.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime

  // Set the moment a session is issued from this request. A signed payload is
  // single-use: without this, re-polling it would mint unlimited sessions from
  // one signature.
  consumedAt DateTime?

  @@index([status, expiresAt])
}

enum SignInStatus {
  PENDING
  SIGNED
  REJECTED
  EXPIRED
}

/**
 * Bearer session. Only the SHA-256 hash of the token is stored, so a database
 * leak does not hand over live sessions.
 */
model Session {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// ------------------------------------------------------------------ events --

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  venue       String?
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])

  // On-ledger issuance. Taxon groups every ticket for this event.
  nftTaxon Int

  // Basis points (100 bps = 1%). Under brokered mode the organizer is the
  // issuer and collects royaltyBps as TransferFee; Hubworld brokers the
  // NFTokenAcceptOffer and takes platformBps from the spread.
  royaltyBps  Int @default(0)
  platformBps Int @default(0)

  ticketCount Int         @default(0)
  status      EventStatus @default(DRAFT)

  tickets      Ticket[]
  mintRequests MintRequest[]

  @@index([status, startsAt])
}

/**
 * One in-flight NFTokenMint awaiting the organizer's signature in Xaman.
 *
 * Minting is asynchronous and Hubworld never signs: we build the transaction,
 * hand it to Xaman, and only learn the NFTokenID after the organizer signs and
 * the ledger validates. This row is what survives that gap — without it a
 * signed mint whose poll never came back would be an NFT on-ledger that
 * Hubworld has no record of.
 */
model MintRequest {
  id          String     @id @default(uuid())
  payloadUuid String     @unique // Xaman payload UUID
  status      MintStatus @default(PENDING)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // The organizer, who is also the NFT issuer under brokered mode.
  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  // Off-ledger ticket metadata, applied to the Ticket once the mint lands.
  seat String?
  tier String?

  // Populated only after the ledger validates the transaction.
  txHash     String?
  nfTokenId  String?
  ticketId   String? @unique
  resolvedAt DateTime?

  // Why a mint failed, for the organizer to act on.
  failureReason String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([status, expiresAt])
  @@index([eventId, createdAt])
}

enum MintStatus {
  PENDING
  SIGNED // signed in Xaman, ledger result not yet confirmed
  MINTED // validated on-ledger, Ticket row written
  REJECTED
  EXPIRED
  FAILED // signed but the ledger rejected it
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  COMPLETED
  CANCELLED
}

// ----------------------------------------------------------------- tickets --

model Ticket {
  id        String @id @default(uuid())
  nfTokenId String @unique // 64-char hex NFTokenID — the ticket's real identity

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Last KNOWN owner. Reconciled from the ledger; may lag reality, and may be
  // an address belonging to nobody with a Hubworld account.
  ownerId      String?
  owner        User?     @relation("TicketOwner", fields: [ownerId], references: [id])
  ownerAddress String?
  syncedAt     DateTime?

  seat   String?
  tier   String?
  status TicketStatus @default(MINTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]
  auctions  Auction[]
  transfers Transfer[]
  gifts     Gift[]

  @@index([eventId, status])
  @@index([ownerId])
}

/**
 * A peer-to-peer gift in flight.
 *
 * XRPL has no "transfer" transaction, so a gift is TWO signatures on two
 * different devices: the sender creates a zero-amount sell offer restricted to
 * the recipient, then the recipient accepts it. Ownership does not move until
 * that second signature validates.
 *
 * Both halves are tracked here because the sender and the recipient poll
 * independently, and either can abandon partway.
 */
model Gift {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  fromId String
  from   User   @relation("GiftSender", fields: [fromId], references: [id])

  toId String
  to   User   @relation("GiftRecipient", fields: [toId], references: [id])

  // Snapshotted at creation: the addresses the offer was actually built for.
  // Re-resolving @handles later could silently retarget a gift in flight.
  fromAddress String
  toAddress   String

  status GiftStatus @default(PENDING_OFFER)

  // Phase 1 — sender creates the offer.
  offerPayloadUuid String  @unique
  offerTxHash      String?
  offerIndex       String? // NFTokenOffer ledger index, assigned by the ledger

  // Phase 2 — recipient accepts it.
  acceptPayloadUuid String? @unique
  acceptTxHash      String?

  // Withdrawal — the sender changing their mind. Once the offer exists
  // on-ledger it can only be removed by a signed NFTokenCancelOffer, so this
  // needs its own payload rather than a local status flip.
  cancelPayloadUuid String? @unique
  cancelTxHash      String?

  failureReason String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  offeredAt  DateTime?
  resolvedAt DateTime?

  @@index([toId, status])
  @@index([fromId, status])
  @@index([ticketId, createdAt])
}

enum GiftStatus {
  PENDING_OFFER // waiting for the sender to sign
  OFFERED // offer is live on-ledger, waiting for the recipient
  ACCEPTING // recipient signed, ledger result not yet confirmed
  ACCEPTED // ownership moved
  DECLINED // recipient refused
  CANCELLING // sender signed a withdrawal, ledger result not yet confirmed
  CANCELLED // sender withdrew, or never signed
  EXPIRED
  FAILED // a signed transaction the ledger rejected
}

enum TicketStatus {
  MINTED
  LISTED
  IN_AUCTION
  REDEEMED
  BURNED
}

// ------------------------------------------------------- fixed-price sales --

/**
 * A fixed-price resale, settled in XRPL brokered mode.
 *
 * THREE signatures, on three different accounts:
 *   1. seller   NFTokenCreateOffer  Amount=price, Destination=broker, tfSell
 *   2. buyer    NFTokenCreateOffer  Amount=price+fee, Owner=seller  (a bid)
 *   3. Hubworld NFTokenAcceptOffer  both offers + NFTokenBrokerFee=fee
 *
 * The seller's `Destination` is the broker so nobody can accept the sell offer
 * directly and bypass the platform fee. The organizer's royalty is not modelled
 * here at all — the NFToken's native TransferFee deducts it and pays the issuer
 * automatically, which is the whole reason minting sets it.
 */
model Listing {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  sellerId String
  seller   User   @relation("ListingSeller", fields: [sellerId], references: [id])
  // Snapshotted: re-resolving later could retarget a listing already on-ledger.
  sellerAddress String

  /// What the seller receives before the issuer's TransferFee. Always drops.
  priceDrops BigInt
  /// Hubworld's cut, fixed at listing time from the event's platformBps, so a
  /// later config change cannot alter the terms a buyer already saw.
  platformFeeDrops BigInt @default(0)

  // Phase 1 — the seller's sell offer.
  listPayloadUuid String  @unique
  listTxHash      String?
  offerIndex      String? // NFTokenOffer index, assigned by the ledger

  // Phase 2 — the buyer's bid.
  buyerId        String?
  buyer          User?   @relation("ListingBuyer", fields: [buyerId], references: [id])
  buyerAddress   String?
  buyPayloadUuid String? @unique
  buyTxHash      String?
  buyOfferIndex  String?

  // Phase 3 — Hubworld's brokered match.
  brokerTxHash String?

  // Withdrawal, which needs a signed NFTokenCancelOffer once the offer exists.
  cancelPayloadUuid String? @unique
  cancelTxHash      String?

  /// Set when this sell offer exists to back an AUCTION rather than a
  /// fixed-price sale. Such a listing must NEVER appear in the marketplace or be
  /// directly buyable — its price is the auction floor, so buying it outright
  /// would take the ticket for the reserve and bypass the bidding entirely.
  auctionId String?  @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])

  status        ListingStatus @default(PENDING_OFFER)
  failureReason String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  listedAt  DateTime?
  closedAt  DateTime?

  @@index([status, createdAt])
  @@index([ticketId, createdAt])
  @@index([sellerId, status])
}

enum ListingStatus {
  PENDING_OFFER // waiting for the seller to sign
  ACTIVE // sell offer live on-ledger, purchasable
  BUYER_PENDING // a buyer committed, waiting for their signature
  SETTLING // both offers exist; Hubworld is brokering
  SOLD
  CANCELLING // seller signed a withdrawal, not yet confirmed
  CANCELLED
  EXPIRED
  FAILED
}

// ---------------------------------------------------------------- auctions --

model Auction {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  startsAt     DateTime
  endsAt       DateTime
  reserveDrops BigInt?

  status    AuctionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())

  bids Bid[]
  /// The holder's sell offer, which settlement brokers the winning bid against.
  listing Listing?

  @@index([status, endsAt])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  SETTLING
  SETTLED
  CANCELLED
}

/**
 * One bid: an XRPL buy offer, not an escrow.
 *
 * The original design escrowed each bid, but an XRPL `Escrow` releases on a time
 * or crypto-condition trigger and knows nothing about the NFT, so it cannot
 * settle a ticket sale atomically — it can pay a seller whose ticket never moves.
 * `NFTokenAcceptOffer` moves the NFT and the XRP together, all-or-nothing, so a
 * bid is an `NFTokenCreateOffer` with `Destination` = the broker.
 *
 * The trade-off, stated plainly: **funds are not locked.** A bidder can spend the
 * money after bidding, and settlement then fails with `tecINSUFFICIENT_FUNDS`.
 * Balance is therefore checked when the bid is placed and again at settlement,
 * falling back to the next-highest bid.
 *
 * The compensating benefit is that losing costs nothing: there is no refund to
 * process and no cancellation transaction a loser must sign. A losing offer is
 * inert on-ledger because only the broker can accept it.
 */
model Bid {
  id String @id @default(uuid())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])

  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id])
  // Snapshotted: re-resolving the handle later could retarget a live offer.
  bidderAddress String?

  /// What the bidder pays if they win. The platform fee and the issuer's
  /// royalty come out of this, so the seller nets less. Always drops.
  amountDrops BigInt

  // The Xaman payload the bidder signs, and the resulting on-ledger buy offer.
  // buyOfferIndex is assigned by the ledger and is what settlement matches.
  bidPayloadUuid String? @unique
  buyTxHash      String?
  buyOfferIndex  String?

  status        BidStatus @default(PENDING)
  failureReason String?

  placedAt   DateTime  @default(now())
  expiresAt  DateTime?
  committedAt DateTime?

  // Drives the real-time price tracker: bids for one auction, in time order.
  @@index([auctionId, placedAt])
  @@index([auctionId, status])
}

enum BidStatus {
  PENDING // payload created, not yet signed — must NOT count as price
  COMMITTED // buy offer live on-ledger; this is a real bid
  OUTBID // superseded by a higher committed bid
  WON
  LOST // auction ended without winning; nothing to refund
  CANCELLED // withdrawn by the bidder
  FAILED // signed but the ledger rejected it
}

// -------------------------------------------------- provenance / transfers --

// Append-only history. For ticketing this is anti-fraud infrastructure:
// "who held this, when, and by which transaction" must be answerable.
model Transfer {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  fromAddress String?
  toAddress   String
  txHash      String       @unique
  kind        TransferKind
  occurredAt  DateTime

  @@index([ticketId, occurredAt])
}

enum TransferKind {
  MINT
  GIFT
  SALE
  AUCTION_SETTLE
  BURN
}
