{
  // The build compiles only src/ (rootDir), so tests would otherwise never be
  // typechecked and could rot silently. This config checks them without
  // emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": null
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
