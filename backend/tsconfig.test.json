{
  // The build compiles only src/ (rootDir), so tests would otherwise never be
  // typechecked and could rot silently. This config checks them without
  // emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": null
  },
  // The schema-touching scripts are typechecked; the ledger spikes are not.
  // They were previously outside every tsconfig, so a schema change that every
  // route caught at build time reached these only as a runtime failure partway
  // through a run. The spikes are excluded because they cast loosely against
  // xrpl's types on purpose, are imported by nothing, and touch no tables.
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/backfill-broker-address.ts",
    "scripts/broker-match.ts",
    "scripts/cancel-abandoned.ts",
    "scripts/create-auction.ts",
    "scripts/create-event.ts",
    "scripts/demo-reset.ts",
    "scripts/demo-seed.ts",
    "scripts/grant-role.ts",
    "scripts/ledger-sync.ts",
    "scripts/payload-report.ts",
    "scripts/purge-test-data.ts",
    "scripts/settle-auctions.ts",
    "scripts/simulate-auction.ts"
  ]
}
