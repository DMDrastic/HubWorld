{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:test:setup": "tsx scripts/setup-test-db.ts",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "event:create": "tsx scripts/create-event.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "stryker run",
    "platform:setup": "tsx scripts/setup-platform-account.ts",
    "auction:create": "tsx scripts/create-auction.ts",
    "broker:match": "tsx scripts/broker-match.ts",
    "ledger:sync": "tsx scripts/ledger-sync.ts",
    "broker:backfill": "tsx scripts/backfill-broker-address.ts",
    "auction:settle": "tsx scripts/settle-auctions.ts",
    "role:grant": "tsx scripts/grant-role.ts",
    "payloads:cancel": "tsx scripts/cancel-abandoned.ts",
    "simulate:auction": "tsx scripts/simulate-auction.ts",
    "purge:test": "tsx scripts/purge-test-data.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@socket.io/postgres-adapter": "^0.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "xrpl": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
